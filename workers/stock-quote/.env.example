# Copy to .env for local runs (.env is gitignored).  In a cloud host, set these as app settings.

# Comma-separated ticker symbols to refresh.
STOCK_SYMBOLS=MSFT

# Quote provider: Finnhub (https://finnhub.io).  Check its terms before displaying quotes to users.
FINNHUB_API_KEY=

# Site that hosts the list (see scripts/Set-StockTickerList.ps1) and the list title.
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com
STOCK_TICKER_LIST_TITLE=Stock Ticker

# Entra ID app registration with Microsoft Graph Sites.Selected (application), granted write on the site.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Minutes between refreshes for `npm run stock-quote:start`.
REFRESH_INTERVAL_MINUTES=15
