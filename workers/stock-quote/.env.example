# Settings for the stock-quote worker.  For local runs, copy this file to .env (gitignored); npm run
# stock-quote:once / :start load it automatically.  In a cloud host, set these as app settings and keep
# the secrets in Key Vault / Secrets Manager.  See docs/workers.md.

# Comma-separated ticker symbols to refresh.  The header shows the list item with the lowest ID.
STOCK_SYMBOLS=MSFT

# Alpha Vantage API key (https://www.alphavantage.co/support/#api-key).  Secret.
# A free key allows 25 requests a day: one per symbol per refresh.
ALPHA_VANTAGE_API_KEY=

# Site that hosts the list (the root site hosts shared lists) and the list title.  The list is created
# by scripts/Set-StockTickerList.ps1; the title must match stockTicker.listTitle in
# scripts/config/header.*.json.
SHAREPOINT_SITE_URL=https://mmcbpm.sharepoint.com
STOCK_TICKER_LIST_TITLE=Stock Ticker

# Worker app registration (Microsoft Graph Sites.Selected, granted Write on SHAREPOINT_SITE_URL).
# See "App registration" in docs/workers.md.
#   TENANT_ID      Directory (tenant) ID
#   CLIENT_ID      Application (client) ID
#   CLIENT_SECRET  client secret VALUE (not its ID).  Secret.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Minutes between refreshes for `npm run stock-quote:start`.  60 keeps one symbol within the free
# Alpha Vantage limit (24 requests a day).
REFRESH_INTERVAL_MINUTES=60
